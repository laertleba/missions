# Copy this file to .env and fill in your Supabase project credentials.
# Find these in: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — base URL of the missions-server API (see server/README.md).
# Leave unset to run without the domain-restricted task-assignment
# feature; it stays fully hidden with no errors when this is empty.
VITE_ASSIGNMENTS_API_URL=
