# Copy to .env and fill in real values. Never commit .env.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely — it
# must only ever exist here (server-side / host provider dashboard),
# never in the frontend or in any committed file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Missions <notifications@yourdomain.com>

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173,https://missions.laertleba.com

PORT=3000
